{
  "name": "dsh-restart",
  "version": "1.3.0",
  "description": "Adds a small restart button beside the Plugins page title that relaunches DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "restart"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VictorGol/dsh-restart.git"
  },
  "homepage": "https://github.com/VictorGol/dsh-restart#readme",
  "bugs": {
    "url": "https://github.com/VictorGol/dsh-restart/issues"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  }
}
